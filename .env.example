# ── Required: AI APIs ──────────────────────────────────────────────────────────
# Anthropic Claude (scanner + filter + research + scriptwriter)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (TTS audio generation — used in prototype)
OPENAI_API_KEY=your_openai_api_key_here

# ── Phase 2: Multi-voice audio ─────────────────────────────────────────────────
# ElevenLabs (upgrade from OpenAI TTS for distinct multi-voice episodes)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ── Phase 3: Audio file hosting ────────────────────────────────────────────────
# Backblaze B2 (cheap object storage for MP3 files ~$0.006/GB/mo)
B2_KEY_ID=your_b2_key_id_here
B2_APPLICATION_KEY=your_b2_application_key_here
B2_BUCKET_NAME=your-podcast-audio-bucket

# ── Phase 3: RSS feed publishing ───────────────────────────────────────────────
# GitHub Pages URL for RSS feed (set after enabling GitHub Pages on repo)
PODCAST_BASE_URL=https://your-username.github.io/podcast-builder
